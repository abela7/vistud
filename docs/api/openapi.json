{
  "openapi": "3.1.0",
  "info": {
    "title": "ViStud API",
    "version": "1",
    "description": "The JSON API under /api/v1. Conventions: docs/architecture/conventions.md. Stability of each operation: x-stability, and docs/architecture/contracts.md. Browser clients authenticate with the session cookie and send X-XSRF-TOKEN on writes."
  },
  "paths": {
    "/api/v1/me": {
      "get": {
        "operationId": "getMe",
        "summary": "The current account, its roles, its learner and the active area",
        "x-stability": "provisional",
        "responses": {
          "200": {
            "description": "The current account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/journal/entries/{id}": {
      "get": {
        "operationId": "getJournalEntry",
        "summary": "One of the current learner's own journal entries, with its content unless a redaction blocks it",
        "x-stability": "provisional",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The entry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JournalEntry"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/notes/{id}": {
      "get": {
        "operationId": "getNote",
        "summary": "One of the current learner's own notes, at its current version. A note in the trash answers 410",
        "x-stability": "provisional",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The note",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "410": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "put": {
        "operationId": "saveNote",
        "summary": "Saves the editor's document as the note's next version (ADR 0003 section 5.3). Only updates: it never creates a note",
        "x-stability": "provisional",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NoteSave"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved, or already saved under this save_id, or unchanged",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedVersion"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error",
            "description": "version_conflict: base_version is not the current version; details.current_version says which is"
          },
          "410": {
            "$ref": "#/components/responses/Error"
          },
          "419": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/sync/tombstones": {
      "get": {
        "operationId": "listTombstones",
        "summary": "The learner's deletion records after a cursor, oldest first (ADR 0003 section 5.4). Browsers read them before replaying drafts",
        "x-stability": "provisional",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The cursor of the last record already seen; 0 or none for all"
          }
        ],
        "responses": {
          "200": {
            "description": "Up to 500 records",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tombstones"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Error": {
        "description": "The error envelope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Me": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "account",
          "learner",
          "area"
        ],
        "properties": {
          "account": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "email",
              "roles",
              "two_factor_confirmed"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "student",
                    "admin"
                  ]
                }
              },
              "two_factor_confirmed": {
                "type": "boolean"
              }
            }
          },
          "learner": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "id",
              "timezone"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "timezone": {
                "type": "string"
              }
            }
          },
          "area": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "student",
              "admin",
              null
            ]
          }
        }
      },
      "JournalEntry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "position",
          "kind",
          "type",
          "type_version",
          "actor",
          "origin",
          "occurred_at",
          "occurred_until",
          "precision",
          "tz",
          "interval",
          "recorded_at",
          "received_at",
          "capture_key",
          "session",
          "activity",
          "links",
          "mentions",
          "body",
          "content",
          "blocked"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "position": {
            "type": "integer"
          },
          "kind": {
            "type": "string",
            "enum": [
              "exposure",
              "attempt",
              "question",
              "self_report",
              "claim",
              "record",
              "amendment"
            ]
          },
          "type": {
            "type": "string"
          },
          "type_version": {
            "type": "integer"
          },
          "actor": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id",
              "channel"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "channel": {
                "type": "string"
              }
            }
          },
          "origin": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurred_at": {
            "type": "string"
          },
          "occurred_until": {
            "type": [
              "string",
              "null"
            ]
          },
          "precision": {
            "type": "string",
            "enum": [
              "exact",
              "minute",
              "day",
              "week"
            ]
          },
          "tz": {
            "type": "string"
          },
          "interval": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lo",
              "hi"
            ],
            "properties": {
              "lo": {
                "type": "string"
              },
              "hi": {
                "type": "string"
              }
            }
          },
          "recorded_at": {
            "type": "string"
          },
          "received_at": {
            "type": "string"
          },
          "capture_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "session": {
            "type": [
              "string",
              "null"
            ]
          },
          "activity": {
            "type": [
              "string",
              "null"
            ]
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rel",
                "target",
                "role"
              ],
              "properties": {
                "rel": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "role": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "mentions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "n",
                "field",
                "start",
                "end"
              ],
              "properties": {
                "n": {
                  "type": "integer"
                },
                "field": {
                  "type": "string"
                },
                "start": {
                  "type": "integer"
                },
                "end": {
                  "type": "integer"
                }
              }
            }
          },
          "body": {
            "type": "object",
            "description": "Kind-specific fields, ADR 0002 \u00a74-5"
          },
          "content": {
            "type": "object",
            "description": "Named text fields. Empty when blocked"
          },
          "blocked": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "request_id"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "details": {
                "type": "object"
              }
            }
          }
        }
      },
      "Note": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "workspace",
          "module",
          "folder",
          "title",
          "version",
          "doc",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "workspace": {
            "type": "string"
          },
          "module": {
            "type": [
              "string",
              "null"
            ],
            "description": "Null at the workspace's top level"
          },
          "folder": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string",
            "description": "Empty for an untitled note"
          },
          "version": {
            "type": "integer"
          },
          "doc": {
            "type": "object",
            "description": "The editor's document (ProseMirror JSON), as cleaned by App\\Study\\NoteDoc"
          },
          "updated_at": {
            "type": "string"
          }
        }
      },
      "NoteSave": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "base_version",
          "save_id",
          "client_id",
          "title",
          "doc"
        ],
        "properties": {
          "base_version": {
            "type": "integer",
            "description": "The version this change is based on"
          },
          "save_id": {
            "type": "string",
            "description": "8-64 letters, digits, - or _; a retry with the same save_id answers the same"
          },
          "client_id": {
            "type": "string",
            "description": "The browser tab, 8-64 letters, digits, - or _"
          },
          "title": {
            "type": "string"
          },
          "doc": {
            "type": "object"
          },
          "kind": {
            "type": "string",
            "enum": [
              "autosave",
              "conflict_resolution"
            ]
          }
        }
      },
      "SavedVersion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "saved_at"
        ],
        "properties": {
          "version": {
            "type": "integer"
          },
          "saved_at": {
            "type": "string"
          }
        }
      },
      "Tombstones": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "next_since",
          "more"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cursor",
                "entity_type",
                "entity_id",
                "kind",
                "at"
              ],
              "properties": {
                "cursor": {
                  "type": "integer"
                },
                "entity_type": {
                  "type": "string",
                  "enum": [
                    "note"
                  ]
                },
                "entity_id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "trashed",
                    "restored",
                    "deleted",
                    "redacted"
                  ]
                },
                "at": {
                  "type": "string"
                }
              }
            }
          },
          "next_since": {
            "type": "integer",
            "description": "The cursor to send next time"
          },
          "more": {
            "type": "boolean",
            "description": "More records follow: ask again with next_since"
          }
        }
      }
    }
  }
}
