# The ViStud site. ${VISTUD_HOST} is filled in at start (the web address, from the settings file).
# CyberPanel's web server (OpenLiteSpeed) already handles https and forwards requests here.
server {
    listen 8080;
    server_name _;

    root /var/www/html/public;
    index index.php;

    # Files are up to 25 MB and recording pieces are small.
    client_max_body_size 40m;

    # The real visitor's address arrives from the web server in front, which runs on this machine (Docker's network).
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 192.168.0.0/16;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # AI apps call /mcp and may wait up to the time Claude allows (240 s).
    location = /mcp {
        try_files $uri /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass 127.0.0.1:9000;
        include /etc/nginx/fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        # Everything the visitor sees is https, and always on this address.
        fastcgi_param HTTPS on;
        fastcgi_param HTTP_HOST ${VISTUD_HOST};
        fastcgi_param SERVER_NAME ${VISTUD_HOST};
        fastcgi_read_timeout 250s;
        fastcgi_send_timeout 250s;
        # Chat answers stream in as they are written.
        fastcgi_buffering off;
    }

    # Never serve hidden files (.env, .git), except the certificate check path.
    location ~ /\.(?!well-known) {
        deny all;
    }
}
